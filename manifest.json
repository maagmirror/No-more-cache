{
  "manifest_version": 3,
  "name": "No More Cache — per-site cache killer",
  "version": "1.0.0",
  "description": "Clear and disable browser + CDN cache per site. Keep chosen sites always fresh — no stale images, scripts, or CSS.",
  "permissions": [
    "browsingData",
    "tabs",
    "storage",
    "webNavigation",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_title": "Cache purge",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  }
}
